digraph Kanban {
graph [layout=dot,rankdir=TB,splines=ortho,bgcolor="#f4f7fb",pad="0.6",nodesep="0.9",ranksep="1.3",fontname="Segoe UI",fontsize=25,fontcolor="#17324b",labelloc=t,labeljust=l,label="JavaOpenF | Modelo UML de datos del Kanban\n14 entidades - nombres actuales y propuestos - relaciones ortogonales\nAzul: clase existente   Violeta: clase nueva   *: atributo por agregar   ?: opcional\nId / Texto / Numero / FechaHora son tipos conceptuales; las HU guian la implementacion"];
node [shape=record,style=filled,fontname="Segoe UI",fontsize=14,fontcolor="#20374c",margin="0.19,0.13",penwidth=1.3];
edge [fontname="Segoe UI",fontsize=10,fontcolor="#48647b",arrowsize=0.65,penwidth=1.1,color="#668da7"];
UserEntity [label="{UserEntity\nusers\n«EXISTENTE»|id : Id\lemail : Texto\lname : Texto\llastName : Texto\lpassword : Texto\lactive : Booleano *\lcreated_at : FechaHora\lupdated_at : FechaHora\l}",color="#5988aa",fillcolor="#eaf3fa",group="core"];
ProjectEntity [label="{ProjectEntity\nprojects\n«EXISTENTE»|id : Id\ltitle : Texto\ldescription : Texto?\lowner_id : Id\larchived_at : FechaHora? *\ldeleted_at : FechaHora? *\lcreated_at : FechaHora\lupdated_at : FechaHora\l}",color="#5988aa",fillcolor="#eaf3fa",group="core"];
ProjectColumnEntity [label="{ProjectColumnEntity\nproject_column\n«EXISTENTE»|id : Id\lproject_id : Id\lname : Texto\lcolor : Color\lpositionY : Numero\lflow_category : CategoriaFlujo *\lwip_limit : Numero? *\l}",color="#5988aa",fillcolor="#eaf3fa",group="core"];
TaskEntity [label="{TaskEntity\nproject_task\n«EXISTENTE»|id : Id\lproject_id : Id\lcolumn_id : Id\lauthor_id : Id\lassignee_id : Id? *\lcode : Texto\ltitle : Texto\ldescription : Texto?\lpriority : TaskPriority\lposition_y : Numero\ldue_at : FechaHora? *\lblocked_reason : Texto? *\larchived_at : FechaHora? *\ldeleted_at : FechaHora? *\lcreated_at : FechaHora\lupdated_at : FechaHora\l}",color="#5988aa",fillcolor="#eaf3fa",group="core"];
MemberEntity [label="{MemberEntity\nmembers\n«NUEVA»|id : Id\lproject_id : Id\luser_id : Id\lrole : Rol\l}",color="#8b70b0",fillcolor="#f3eef9"];
ProjectInvitationEntity [label="{ProjectInvitationEntity\nproject_invitations\n«NUEVA»|id : Id\lproject_id : Id\linvited_by : Id\lemail : Texto\lrole : Rol\lstatus : EstadoInvitacion\ltoken_hash : Hash\lexpires_at : FechaHora\l}",color="#8b70b0",fillcolor="#f3eef9"];
ProjectTagEntity [label="{ProjectTagEntity\nproject_tags\n«NUEVA»|id : Id\lproject_id : Id\lname : Texto\lcolor : Color\l}",color="#8b70b0",fillcolor="#f3eef9"];
TaskTagEntity [label="{TaskTagEntity\ntask_tags\n«NUEVA»|task_id : Id\ltag_id : Id\l}",color="#8b70b0",fillcolor="#f3eef9"];
TaskChecklistItemEntity [label="{TaskChecklistItemEntity\ntask_checklist\n«NUEVA»|id : Id\ltask_id : Id\ltext : Texto\lposition : Numero\lcompleted : Booleano\l}",color="#8b70b0",fillcolor="#f3eef9"];
TaskCommentEntity [label="{TaskCommentEntity\ntask_comments\n«NUEVA»|id : Id\ltask_id : Id\lauthor_id : Id\lcontent : Texto\lcreated_at : FechaHora\lupdated_at : FechaHora\l}",color="#8b70b0",fillcolor="#f3eef9"];
TaskEventEntity [label="{TaskEventEntity\ntask_events\n«NUEVA»|id : Id\ltask_id : Id\lactor_id : Id\levent_type : TipoEvento\loccurred_at : FechaHora\lbefore_data : Datos?\lafter_data : Datos\l}",color="#8b70b0",fillcolor="#f3eef9"];
ProjectEventEntity [label="{ProjectEventEntity\nproject_events\n«NUEVA»|id : Id\lproject_id : Id\lactor_id : Id\levent_type : TipoEvento\loccurred_at : FechaHora\lbefore_data : Datos?\lafter_data : Datos\l}",color="#8b70b0",fillcolor="#f3eef9"];
ChannelEntity [label="{ChannelEntity\nchannels\n«EXISTENTE»|id : Id\lproject_id : Id *\ltitle : Texto\lcreated_at : FechaHora\lupdated_at : FechaHora\l}",color="#5988aa",fillcolor="#eaf3fa"];
MessageEntity [label="{MessageEntity\nmessages\n«EXISTENTE»|id : Id\lproject_id : Id *\lchannel_id : Id\lauthor_id : Id *\lcontent : Texto\lcreated_at : FechaHora\lupdated_at : FechaHora\l}",color="#5988aa",fillcolor="#eaf3fa"];
UserEntity -> ProjectEntity [xlabel="owner_id  [1:N]",color="#668da7",weight=20];
ProjectEntity -> ProjectColumnEntity [xlabel="project_id  [1:N]",color="#668da7",weight=20];
ProjectEntity -> TaskEntity [xlabel="project_id  [1:N]",color="#668da7",constraint=false,weight=0];
ProjectColumnEntity -> TaskEntity [xlabel="column_id  [1:N]",color="#668da7",weight=20];
UserEntity -> TaskEntity [xlabel="author_id  [1:N]",color="#a9b5c4",constraint=false,weight=0];
UserEntity -> TaskEntity [xlabel="assignee_id  [0..1:N]",color="#a9b5c4",constraint=false,weight=0];
ProjectEntity -> MemberEntity [xlabel="project_id  [1:N]",color="#668da7",weight=2];
UserEntity -> MemberEntity [xlabel="user_id  [1:N]",color="#a9b5c4",constraint=false,weight=0];
ProjectEntity -> ProjectInvitationEntity [xlabel="project_id  [1:N]",color="#668da7",weight=2];
UserEntity -> ProjectInvitationEntity [xlabel="invited_by  [1:N]",color="#a9b5c4",constraint=false,weight=0];
ProjectEntity -> ProjectTagEntity [xlabel="project_id  [1:N]",color="#668da7",weight=2];
TaskEntity -> TaskTagEntity [xlabel="task_id  [1:N]",color="#668da7",weight=2];
ProjectTagEntity -> TaskTagEntity [xlabel="tag_id  [1:N]",color="#668da7",weight=2];
TaskEntity -> TaskChecklistItemEntity [xlabel="task_id  [1:N]",color="#668da7",weight=2];
TaskEntity -> TaskCommentEntity [xlabel="task_id  [1:N]",color="#668da7",weight=2];
UserEntity -> TaskCommentEntity [xlabel="author_id  [1:N]",color="#a9b5c4",constraint=false,weight=0];
TaskEntity -> TaskEventEntity [xlabel="task_id  [1:N]",color="#668da7",weight=2];
UserEntity -> TaskEventEntity [xlabel="actor_id  [1:N]",color="#a9b5c4",constraint=false,weight=0];
ProjectEntity -> ProjectEventEntity [xlabel="project_id  [1:N]",color="#668da7",weight=2];
UserEntity -> ProjectEventEntity [xlabel="actor_id  [1:N]",color="#a9b5c4",constraint=false,weight=0];
ProjectEntity -> ChannelEntity [xlabel="project_id  [1:N]",color="#668da7",weight=2];
ProjectEntity -> MessageEntity [xlabel="project_id  [1:N]",color="#668da7",constraint=false,weight=0];
ChannelEntity -> MessageEntity [xlabel="channel_id  [1:N]",color="#668da7",weight=2];
UserEntity -> MessageEntity [xlabel="author_id  [1:N]",color="#a9b5c4",constraint=false,weight=0];
}
