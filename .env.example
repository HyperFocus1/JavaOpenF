# Opcional: Docker Compose funciona también sin crear .env.
OPENF_HTTP_PORT=8080
OPENF_MYSQL_PORT=3306
OPENF_KAFKA_PORT=9092
OPENF_DB_PASSWORD=1234
# Si queda vacío, el contenedor genera y conserva un secreto privado en jwt_data.
JWT_SECRET=
# Vacío: usa el origen del puerto HTTP elegido y http://localhost:5173.
WEBSOCKET_ALLOWED_ORIGINS=
